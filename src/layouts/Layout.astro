---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Chatbot from "../components/Chatbot.astro";
import SEOHead from "../components/SEOHead.astro";

type Translations = typeof import("../i18n/en").default;

export interface Props {
  lang: string;
  t?: Translations;
  showLoader?: boolean;
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  type?: string;
  structuredData?: object | object[];
}

const {
  lang,
  t,
  showLoader = true,
  title,
  description,
  keywords,
  image,
  canonicalPath,
  noindex,
  type,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="overflow-x-clip">
  <head>
    <SEOHead
      lang={lang}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      canonicalPath={canonicalPath}
      noindex={noindex}
      type={type}
      structuredData={structuredData}
    />
  </head>

  <body
    class="font-family antialiased overflow-x-clip bg-white flex flex-col justify-center items-center w-full"
    data-show-loader={showLoader ? "true" : "false"}
  >
    <Header content={t?.header} />
    <main class="flex flex-col w-full items-center pt-(--header-height)">
      <slot />
    </main>
    <Footer content={t?.footer} />
    {
      /*
    <Chatbot /> */
    }
  </body>
</html>

<script>
  function initGlobalInteractions() {
    // -------------------------------------------------------------
    // 1. ANIMACIONES DE SCROLL (IntersectionObserver)
    // -------------------------------------------------------------
    const animationElements = document.querySelectorAll(
      ".fade-up-a, .fade-down-a, .fade-left-a, .fade-right-a, .progress-reveal, .bars-icon, .fade-down-bounce"
    );

    const animationObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.getBoundingClientRect(); // Fuerza reflow
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                el.classList.add("active");
              });
            });
            animationObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    animationElements.forEach((element) => animationObserver.observe(element));

    // -------------------------------------------------------------
    // 2. INTERACCIÓN DE EMPUJE CON MOUSE (data-push-container)
    // -------------------------------------------------------------
    const pushContainers = document.querySelectorAll<HTMLElement>('[data-push-container]');

    pushContainers.forEach((container) => {
      const img = container.querySelector<HTMLElement>('img');
      
      // Evita vincular event listeners repetidos si la función se vuelve a ejecutar
      if (!img || container.dataset.pushInitialized) return;
      container.dataset.pushInitialized = "true";

      container.addEventListener('mousemove', (e) => {
        const rect = container.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;

        const deltaX = e.clientX - centerX;
        const deltaY = e.clientY - centerY;

        const pushFactor = 0.06;
        const maxDistance = 12;

        const moveX = Math.max(-maxDistance, Math.min(maxDistance, deltaX * pushFactor));
        const moveY = Math.max(-maxDistance, Math.min(maxDistance, deltaY * pushFactor));

        img.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
      });

      container.addEventListener('mouseleave', () => {
        img.style.transform = 'translate3d(0px, 0px, 0)';
      });
    });
  }

  // Ejecución en la carga inicial del documento
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGlobalInteractions);
  } else {
    initGlobalInteractions();
  }

  // Soporte para Astro View Transitions (por si usas transiciones de página en el futuro)
  document.addEventListener("astro:page-load", initGlobalInteractions);
</script>