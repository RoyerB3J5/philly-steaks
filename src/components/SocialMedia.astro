---
const icons = [
  {
    name: "mail-white",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=admin@prestigegrowthpartners.com",
  },
  {
    name: "instagram",
    href: "https://www.instagram.com/prestigegrowthpartnerscorp/?hl=es",
  },
  {
    name: "facebook",
    href: "https://web.facebook.com/people/Prestige-Growth-Partners/61593408904345/?sk=reviews",
