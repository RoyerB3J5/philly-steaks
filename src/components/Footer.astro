---
import {
  emailAddress,
  facebookLink,
  phoneNumber,
  phoneNumberLink,
} from "../constants/info";
import { ChevronDown, ChevronRight, Menu, X, Plus, Minus } from "@lucide/astro";
import Button from "./Button.astro";

type Translations = typeof import("../i18n/en").default;
type FooterContent = Translations["footer"];
interface Props {
  content?: FooterContent;
}
const { content } = Astro.props as Props;

// Obtener la ruta actual y normalizar el path sin prefijo de idioma
const currentPath = Astro.url.pathname;
// Normalizar: remover idioma y trailing slash
const normalized =
  currentPath.replace(/^\/(en|es)/, "").replace(/\/$/, "") || "/";
// Detectar el idioma actual ('en' o 'es')
const match = currentPath.match(/^\/(en|es)/);
const lang = match ? match[1] : "en";
const socialMedia = [
  {
    icon: "fb",
    href: "https://www.facebook.com/orlandophillysteak/",
  },
];
---

<footer class="flex flex-col justify-center items-center w-full">
  <div class="bg-[#0D0D0D] w-full flex justify-center items-center">
    <div
      class="container-full flex flex-col justify-center items-center py-16 md:py-20 gap-18 md:gap-17"
    >
      <div
        class="w-full flex flex-col md:flex-row jusitfy-center md:justify-start items-center md:items-stretch gap-4 md:gap-3 lg:gap-6"
      >
        <a
          href={`/${lang}`}
          aria-label="Ir a la página principal"
          title="Philly Steak - Init"
          class="block"
        >
          <img
            src="/images/logo-footer.svg"
            alt="Logo de Orlando's Philly Steak "
            width="240"
            height="127"
            class="cursor-pointer w-[250px] md:w-[180px] lg:not-last-of-type:w-[250px] h-auto"
          />
        </a>
        <div class="w-[1px] bg-white/10 hidden md:block"></div>
        <div
          class="md:flex-1 md:flex flex-col md:flex-row justify-center md:justify-between items-center gap-6 md:gap-3 lg:gap-6 hidden"
        >
          <div
            class="flex flex-col justify-center items-center md:items-start gap-8 text-white"
          >
            <h3
              class="text-[20px] md:text-[30px] lg:text-[40px] font-bold leading-[125%] font-paragraph text-center md:text-start"
            >
              {content?.section1.title}
            </h3>
            <p
              class="text-[16px] font-paragraph text-[#BDBDBD] leading-[175%] font-normal max-w-[765px]"
            >
              {content?.section1.description}
            </p>
          </div>
          <div
            class="flex flex-row md:flex-col justify-center items-center gap-4"
          >
            <Button
              text={content?.section1.buttons[0].label}
              href={content?.section1.buttons[0].href}
              textClass="uppercase"
              extraBtnClass="bg-secondary border-secondary"
            />
            <Button
              text={content?.section1.buttons[1].label}
              href={content?.section1.buttons[1].href}
              textClass=" uppercase"
              colorText="text-white"
              extraBtnClass="bg-transparent border-white"
            />
          </div>
        </div>
      </div>
      <div class="hidden md:block w-full h-[1px] bg-white/10"></div>
      <div
        class="w-full flex flex-col md:flex-row justify-center md:justify-between items-center md:items-start gap-[51px] md:gap-3 lg:gap-6"
      >
        <div
          class="w-full flex flex-col jutify-center items-center md:items-start gap-6 max-w-[678px]"
        >
          <h3 class="subtitle-sm text-white">
            {content?.section2.about.title}
          </h3>
          <div class="w-25 h-0.75 bg-secondary"></div>
          <p
            class="text-[16px] font-paragraph text-[#F2F2F2] leading-[175%] font-normal max-w-[765px] text-center md:text-start"
            set:html={content?.section2.about.description}
          />
          <div
            class="flex justify-center md:justify-start items-center gap-2 w-full"
          >
            {
              socialMedia.map((item) => (
                <a
                  href={item.href}
                  class="w-10 h-10 border border-[#F2F2F2] rounded-full flex justify-center items-center hover:bg-secondary hover:border-secondary transition-all duration-300 ease-in-out"
                >
                  <img
                    src={`/icons/${item.icon}.svg`}
                    width="24"
                    height="24"
                    class="w-auto h-4.5"
                    decoding="async"
                    loading="lazy"
                    alt={item.icon}
                  />
                </a>
              ))
            }
          </div>
        </div>
        <div
          class="flex flex-col justify-center items-center md:items-start gap-6"
        >
          <h3 class="subtitle-sm text-white whitespace-nowrap">
            {content?.section2.quickLinks.title}
          </h3>
          <div class="w-25 h-0.75 bg-secondary"></div>
          <div
            class="flex flex-col justify-center itmes-center md:items-start gap-6"
          >
            {
              content?.section2.quickLinks.links.map((link) => (
                <a
                  href={`/${lang}${link.href}`}
                  class="text-[16px] font-paragraph text-[#F2F2F2] leading-[21px] font-normal hover:text-secondary transition-all duration-300 ease-in-out flex justify-center md:justify-start items-center gap-[5px] "
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="7"
                    height="10"
                    viewBox="0 0 7 10"
                    fill="none"
                    class="hidden md:block"
                  >
                    <path
                      d="M6.24219 5.52344L1.99219 9.77344C1.67969 10.0859 1.21094 10.0859 0.929688 9.77344L0.210938 9.08594C-0.0703125 8.77344 -0.0703125 8.30469 0.210938 8.02344L3.24219 5.02344L0.210938 1.99219C-0.0703125 1.71094 -0.0703125 1.24219 0.210938 0.929688L0.929688 0.210938C1.21094 -0.0703125 1.67969 -0.0703125 1.99219 0.210938L6.24219 4.46094C6.52344 4.77344 6.52344 5.24219 6.24219 5.52344Z"
                      fill="#F2F2F2"
                    />
                  </svg>
                  <p>{link.label}</p>
                </a>
              ))
            }
          </div>
        </div>
        <div
          class="flex flex-col justify-center items-center md:items-start gap-6"
        >
          <h3 class="subtitle-sm text-white whitespace-nowrap">
            {content?.section2.contact.title}
          </h3>
          <div class="w-25 h-0.75 bg-secondary"></div>
          <div
            class="flex flex-col justify-center items-center md:items-start gap-6"
          >
            {
              content?.section2.contact.items.map((link) => (
                <div class="flex justify-center md:justify-start items-center gap-4">
                  <div class="md:flex justify-center items-center w-10 h-10 bg-secondary rounded-full hidden ">
                    <img
                      src={`/icons/${link.icon}.svg`}
                      alt={link.icon}
                      width="24"
                      height="24"
                      class="w-[19.2px] h-[19.2px] "
                      decoding="async"
                      loading="lazy"
                    />
                  </div>
                  <a
                    href={`/${lang}${link.href}`}
                    class="text-[16px] font-paragraph text-[#F2F2F2] leading-[21px] font-normal hover:text-secondary transition-all duration-300 ease-in-out max-w-[209px] text-center md:text-start"
                  >
                    <p>{link.label}</p>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    class="bg-[#E5E5E5] w-full py-3.5 lg:py-4.5 flex justify-center items-center px-5 xl:px-0"
  >
    <div
      class="w-full max-w-screen lg:max-w-7xl flex flex-col lg:flex-row justify-center items-center gap-2 lg:gap-6"
    >
      <a href="https://inkshapegroup.com/en/">
        <img
          src="/icons/inkshape.svg"
          alt=" Logo de Inkshape Group"
          width="208"
          height="40"
          class="w-27.5 lg:w-34 h-auto block dark:hidden"
        />
      </a>
      <p
        class="text-[10px] lg:text-[12px] lg:text-[13px] leading-[170%] lg:leading-[120%] text-[#404040] dark:text-paragraph-dark font-normal text-center"
      >
        Copyright © 2026 by <a href="https://inkshapegroup.com"
          >Inkshape Group</a
        > | Privacy | <a href="/"> Orlando's Philly Steak </a> | Florida, USA | Call
        Now: <a href={phoneNumberLink}>{phoneNumber}</a>
      </p>
    </div>
  </div>
</footer>
