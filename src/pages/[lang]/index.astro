---
import en from "../../i18n/en";
import es from "../../i18n/es";
import Layout from "../../layouts/Layout.astro";
import Big from "../../sections/Main/Big.astro";
import Halal from "../../sections/Main/Halal.astro";
import Hero from "../../sections/Main/Hero.astro";
import Perfect from "../../sections/Main/Perfect.astro";
import Posts from "../../sections/Main/Posts.astro";
import Quality from "../../sections/Main/Quality.astro";
import Reviews from "../../sections/Main/Reviews.astro";
import Signature from "../../sections/Main/Signature.astro";
import type { Language } from "../../types/language.type";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.main;
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/"
>
  <Hero content={t.main.hero} />
  <Signature content={t.main.steaks} />
  <Halal content={t.main.halal} />
  <Quality content={t.main.quality} />
  <Perfect content={t.main.perfect} />
  <Big content={t.main.big} deliciousContent={t.main.delicious} />
  <Posts content={t.main.clients} />
  <Reviews content={t.main.reviews} />
</Layout>
