---
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en").default;
type DeliciousContent = Translations["main"]["delicious"];
interface Props {
  content: DeliciousContent;
  // When true, renders as an absolute layer (z-0) to sit behind Big
  // inside the pinned Big+Delicious sequence. No own <section>, no script —
  // all animation is driven by Big.astro so scrub + entry never fight.
  asLayer?: boolean;
}
const { content, asLayer = false } = Astro.props as Props;

// Same line-split pattern as Signature / Quality / Perfect so the mask reveal matches
const lines = content.title.split(/<br\s*\/?>/i);
---

{
  asLayer ? (
    <div
      data-delicious-layer
      class="absolute inset-0 z-0 w-full h-full flex justify-center items-center bg-paragraph overflow-hidden"
    >
      <div class="container-full flex flex-col h-full justify-between items-center py-20 md:py-10 relative">
        <img
          data-delicious-photo
          src="/images/main/delicious.webp"
          alt="Delicious"
          class="w-[90%] md:w-[60%] xl:w-[40%] 3xl:w-[60%] h-auto object-cover absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10"
          width="1360"
          height="816"
          decoding="async"
          loading="lazy"
        />
        <div class="flex flex-col justify-center items-start relative z-5 -rotate-4">
          <p
            data-delicious-tag
            class="tag-size text-white text-start md:text-center overflow-hidden"
            set:html={content.tag}
          />
          <h2
            data-delicious-title
            class="text-[56px] md:text-[90px] lg:text-[150px] xl:text-[224px] font-rust text-white leading-[100%] font-normal text-end isolate"
          >
            {lines.map((line, index) => (
              <div
                class={`relative overflow-clip ${index !== 0 ? "z-[3] -mt-[0.4em] pt-[0.4em]" : "z-0"}`}
              >
                <span class="block font-rust" data-delicious-line set:html={line} />
              </div>
            ))}
          </h2>
        </div>
        <div class="w-full flex flex-col justify-center items-center gap-6 max-w-[611px] relative z-5">
          <p data-delicious-desc class="text-white paragraph text-center">
            {content.description}
          </p>
          <div
            data-delicious-cta
            class="flex flex-col md:flex-row justify-center items-center gap-4 w-full md:w-auto"
          >
            <Button
              text={content.buttons[0].label}
              href={content.buttons[0].href}
              textClass="uppercase"
              extraBtnClass="bg-secondary border-secondary"
              width="w-full md:w-[164px]"
            />
            <Button
              text={content?.buttons[1].label}
              href={content?.buttons[1].href}
              textClass=" text-paragraph md:text-white  uppercase"
              extraBtnClass="bg-white md:bg-transparent border-white"
              width="w-full md:w-[164px]"
            />
          </div>
        </div>
      </div>
    </div>
  ) : (
    <section
      data-delicious
      class="w-full h-screen md:h-[65vh] xl:h-screen relative flex justify-center items-center bg-paragraph"
    >
      <div class="container-full flex flex-col h-full justify-between items-center py-10 relative">
        <img
          data-delicious-photo
          src="/images/main/delicious.webp"
          alt="Delicious"
          class="w-[40%] 3xl:w-[60%] h-auto object-cover absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10"
          width="1360"
          height="816"
          decoding="async"
          loading="lazy"
        />
        <div class="flex flex-col justify-center items-start relative z-5 -rotate-4">
          <p
            data-delicious-tag
            class="tag-size text-white text-start md:text-center overflow-hidden"
            set:html={content.tag}
          />
          <h2
            data-delicious-title
            class="text-[56px] md:text-[90px] lg:text-[224px] font-rust text-white leading-[100%] font-normal text-end isolate"
          >
            {lines.map((line, index) => (
              <div
                class={`relative overflow-clip ${index !== 0 ? "z-[3] -mt-[0.4em] pt-[0.4em]" : "z-0"}`}
              >
                <span class="block font-rust" data-delicious-line set:html={line} />
              </div>
            ))}
          </h2>
        </div>
        <div class="w-full flex flex-col justify-center items-center gap-6 max-w-[611px] relative z-5">
          <p data-delicious-desc class="text-white paragraph text-center">
            {content.description}
          </p>
          <div
            data-delicious-cta
            class="flex flex-col md:flex-row justify-center items-center gap-4 w-full md:w-auto"
          >
            <Button
              text={content.buttons[0].label}
              href={content.buttons[0].href}
              textClass="uppercase"
              extraBtnClass="bg-secondary border-secondary"
              width="w-full md:w-[164px]"
            />
            <Button
              text={content?.buttons[1].label}
              href={content?.buttons[1].href}
              textClass=" text-paragraph md:text-white  uppercase"
              extraBtnClass="bg-white md:bg-transparent border-white"
              width="w-full md:w-[164px]"
            />
          </div>
        </div>
      </div>
    </section>
  )
}
