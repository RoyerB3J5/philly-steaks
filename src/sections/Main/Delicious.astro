---
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en").default;
type DeliciousContent = Translations["main"]["delicious"];
interface Props {
  content: DeliciousContent;
}
const { content } = Astro.props as Props;
---

<section
  class="w-full h-screen md:h-[65vh] xl:h-screen relative flex justify-center items-center bg-paragraph"
>
  <div
    class="container-full flex flex-col h-full justify-between items-center py-10"
  >
    <div
      class="flex flex-col justify-center items-start relative z-5 -rotate-4"
    >
      <p
        class="tag-size text-white text-start md:text-center"
        set:html={content.tag}
      />
      <h2
        class="text-[56px] md:text-[90px] lg:text-[224px] font-rust text-white leading-[100%] font-normal fade-up-a text-end"
        set:html={content.title}
      />
    </div>
    <div
      class="w-full flex flex-col justify-center items-center gap-6 max-w-[611px]"
    >
      <p class="text-white paragraph text-center">
        {content.description}
      </p>
      <div
        class="flex flex-col md:flex-row justify-center items-center gap-4 fade-up-a w-full md:w-auto"
      >
        <Button
          text={content.buttons[0].label}
          href={content.buttons[0].href}
          textClass="uppercase"
          extraBtnClass="bg-secondary border-secondary"
          width="w-full md:w-[164px]"
        />
        <Button
          text={content?.buttons[1].label}
          href={content?.buttons[1].href}
          textClass=" text-paragraph md:text-white  uppercase"
          extraBtnClass="bg-white md:bg-transparent border-white"
          width="w-full md:w-[164px]"
        />
      </div>
    </div>
  </div>
</section>
