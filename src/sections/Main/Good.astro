---
type Translations = typeof import("../../i18n/en").default;
type GoodContent = Translations["main"]["Good"];
interface Props {
  content: GoodContent;
  position: string;
}
interface ImageItem {
  src: string;
  alt: string;
  width: number;
  height: number;
  class: string;
}
const { content, position } = Astro.props as Props;
const IMAGES_MAP: Record<string, ImageItem[]> = {
  first: [
    {
      src: "/images/papa.webp",
      alt: "Papa",
      width: 700,
      height: 837,
      class:
        "hidden md:block w-[140px] h-auto absolute -top-[12%] left-[3%] rotate-[20deg]",
    },
  ],
  second: [
    {
      src: "/images/hoja.webp",
      alt: "Hoja",
      width: 151,
      height: 127,
      class:
        "hidden md:block w-[100px] lg:w-[151px] h-auto absolute top-[0%] lg:top-[3%] right-[1%]",
    },
    {
      src: "/images/hoja2.webp",
      alt: "Hoja 2",
      width: 306,
      height: 390,
      class:
        "hidden md:block w-[180px] h-auto absolute -bottom-[20%] xl:bottom-[0%] left-[0] scale-x-[-1]",
    },
  ],
  third: [
    {
      src: "/images/papa.webp",
      alt: "Papa",
      width: 700,
      height: 837,
      class:
        "hidden md:block w-[100px] lg:w-[140px] h-auto absolute top-[3%] left-[2%] rotate-[20deg]",
    },
    {
      src: "/images/lechuga.webp",
      alt: "Lechuga",
      width: 227,
      height: 492,
      class:
        "hidden md:block w-[100px] lg:w-[181px] h-auto absolute top-0 -translate-y-1/2 right-0",
    },
  ],
  four: [
    {
      src: "/images/hoja.webp",
      alt: "Hoja",
      width: 151,
      height: 127,
      class:
        "hidden md:block w-[110px] lg:w-[151px] h-auto absolute top-[0%] lg:top-[3%] right-[1%]",
    },
    {
      src: "/images/hoja2.webp",
      alt: "Hoja 2",
      width: 306,
      height: 390,
      class:
        "hidden md:block w-[150px] lg:w-[180px] h-auto absolute -bottom-[20%] left-[0] scale-x-[-1]",
    },
  ],
};
const currentImages = IMAGES_MAP[position];
---

<section class="w-full flex justify-center items-center bg-white relative z-5">
  {currentImages.map((img) => <img {...img} />)}

  <div
    class="container-full flex flex-col justify-center items-center gap-8 md:gap-12 py-16 md:py-20 lg:py-30"
  >
    <h2 class="subtitle text-primary uppercase text-center">{content.title}</h2>
    <ul
      class="w-full grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-20 justify-center items-start"
    >
      {
        content.Pros.map((pro) => (
          <li class="flex flex-col justify-center items-center gap-6 md:gap-8">
            <img
              src={`/icons/${pro.image}.svg`}
              alt={pro.title}
              width="147"
              height="147"
              class="w-[147px] h-auto "
            />
            <div class="flex flex-col justify-center items-center gap-2 text-center text-primary">
              <h3 class="subtitle-sm uppercase">{pro.title}</h3>
              <p class="paragraph text-center">{pro.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
