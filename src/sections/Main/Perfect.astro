---
type Translations = typeof import("../../i18n/en").default;
type PerfectContent = Translations["main"]["perfect"];
interface Props {
  content: PerfectContent;
}
const { content } = Astro.props as Props;

// Same line-split pattern as the Signature h2 so the mask reveal matches
const lines = content.title.split(/<br\s*\/?>/i);
---

<section
  data-perfect
  class="bg-white flex justify-center items-center h-auto w-full relative md:h-[65vh] xl:h-screen"
>
  <img
    src="/images/main/halal-back.png"
    alt="Halal Background"
    class="absolute inset-0 object-cover object-center w-full h-full z-0"
    width="1440"
    height="810"
    decoding="async"
    loading="lazy"
  />
  <div
    class="container-full flex flex-col justify-between items-center gap-4 md:gap-6 z-10 relative h-full py-18 md:py-12"
  >
    <div class="flex flex-col justify-center items-center gap-6 md:gap-5">
      <p
        data-perfect-tag
        class="tag-size text-paragraph text-center overflow-hidden"
      >
        {content.tag}
      </p>
      <h2
        data-perfect-title
        class="text-[56px] md:text-[96px] font-rust text-paragraph leading-[100%] font-normal text-center isolate"
      >
        {
          lines.map((line, index) => (
            <div
              class={`relative overflow-clip ${index !== 0 ? "z-[3] -mt-[0.4em] pt-[0.4em]" : "z-0"}`}
            >
              <span class="block font-rust" data-perfect-line set:html={line} />
            </div>
          ))
        }
      </h2>
    </div>
    <img
      data-perfect-photo
      src="/images/main/perfect-plate.webp"
      alt="Perfect 1"
      class="w-full max-w-[622px] h-auto z-3 md:hidden block"
      width="1024"
      height="666"
      decoding="async"
      loading="lazy"
    />
    <div
      class="w-full flex flex-col md:flex-row justify-center md:justify-between items-center relative gap-8 md:gap-0"
    >
      <img
        data-perfect-photo
        src="/images/main/perfect-plate.webp"
        alt="Perfect 1"
        class="w-[35%] lg:w-[35%] xl:w-[50%] 2xl:w-[36%] 3xl:w-[50%] max-w-[622px] h-auto absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-3 hidden md:block"
        width="1024"
        height="666"
        decoding="async"
        loading="lazy"
      />
      <div
        data-perfect-item
        class="flex flex-col justify-center items-center md:items-start gap-4 max-w-none md:max-w-[200px] lg:max-w-[280px] xl:max-w-[311px] w-full relative z-0"
      >
        <h3
          class="text-[24px] text-secondary font-rust leading-[120%] font-normal uppercase"
        >
          {content.items[0].title}
        </h3>
        <p class="text-paragraph paragraph text-center md:text-left">
          {content.items[0].description}
        </p>
      </div>
      <div
        data-perfect-item
        class="flex flex-col justify-center items-center md:items-end gap-4 max-w-none md:md:max-w-[200px] lg:max-w-[311px] w-full"
      >
        <h3
          class="text-[24px] text-secondary font-rust leading-[120%] font-normal uppercase"
        >
          {content.items[1].title}
        </h3>
        <p
          class="text-paragraph paragraph text-center md:text-right"
          set:html={content.items[1].description}
        />
      </div>
    </div>
    <div
      data-perfect-item
      class="flex flex-col justify-center items-center gap-4 max-w-none md:max-w-[398px] w-full"
    >
      <h3
        class="text-[24px] text-secondary font-rust leading-[120%] font-normal uppercase"
      >
        {content.items[2].title}
      </h3>
      <p class="text-paragraph paragraph text-center">
        {content.items[2].description}
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "../../utils/animations";

  function initPerfectReveal() {
    const section = document.querySelector<HTMLElement>("[data-perfect]");
    if (!section) return;

    // Guard against double init (DOMContentLoaded + astro:page-load both fire
    // on first load): a second context would create a duplicate timeline +
    // observer fighting over the same elements, leaving partial states behind.
    if (section.dataset.perfectInit === "true") return;
    section.dataset.perfectInit = "true";

    const tag = section.querySelector<HTMLElement>("[data-perfect-tag]");
    const titleLines = section.querySelectorAll<HTMLElement>(
      "[data-perfect-line]",
    );
    const photos = section.querySelectorAll<HTMLElement>(
      "[data-perfect-photo]",
    );
    const items = section.querySelectorAll<HTMLElement>("[data-perfect-item]");
    if (!tag || titleLines.length === 0 || photos.length === 0) return;

    // Respect reduced motion — leave content visible, no animation.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const ctx = gsap.context(() => {
      // Initial states via GSAP only (no CSS opacity:0), so no-JS still shows content.
      gsap.set(tag, { y: 24, autoAlpha: 0 });
      gsap.set(titleLines, { yPercent: 100, autoAlpha: 0 });
      // Plate scales from 0.5 + fully transparent. Only transform is touched,
      // so the desktop -translate-x/y centering (separate CSS properties) stays intact.
      gsap.set(photos, {
        scale: 0.5,
        autoAlpha: 0,
        transformOrigin: "50% 50%",
      });
      // Staged item reveal: animate h3s and ps separately (never the whole
      // item container at once), so h3 can enter first and p after more scroll.
      const itemHeads = Array.from(items)
        .map((el) => el.querySelector("h3"))
        .filter((el): el is HTMLHeadingElement => el !== null);
      const itemParas = Array.from(items)
        .map((el) => el.querySelector("p"))
        .filter((el): el is HTMLParagraphElement => el !== null);
      gsap.set([...itemHeads, ...itemParas], { y: 24, autoAlpha: 0 });

      // Paused timeline driven by IntersectionObserver (no ScrollTrigger,
      // no scrub): plays on enter, resets on leave.
      const tl = gsap.timeline({
        paused: true,
        defaults: { ease: "power2.inOut", overwrite: "auto" },
      });

      // 1. Tag + h2 first (title lines mirror Signature).
      tl.to(tag, { y: 0, autoAlpha: 1, duration: 0.35 }, 0).to(
        titleLines,
        { yPercent: 0, autoAlpha: 1, duration: 0.4, stagger: 0.1 },
        "-=0.15",
      );

      // 2. Plate scales up to its final style.
      tl.to(
        photos,
        { scale: 1, autoAlpha: 1, duration: 0.5, ease: "power2.out" },
        ">0.1",
      );

      // 3. Items are NOT in this timeline — staged per-element observers below:
      // contents 0+1 h3s together, then their ps together after more scroll,
      // then content 2 h3 on its own entry, then its p.

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.intersectionRatio >= 0.3) {
              // In view: replay at normal speed (resets timeScale in case
              // a fast rewind was interrupted mid-exit).
              tl.timeScale(1).play();
            } else if (entry.intersectionRatio === 0) {
              // Fully out of view: snap straight to the initial state so
              // re-entering always replays cleanly from the start.
              tl.pause(0);
            } else {
              // On the way out: rewind quickly while exiting.
              tl.timeScale(2.5).reverse();
            }
          });
        },
        // Starts once the section is 30% into the viewport.
        { threshold: [0, 0.3], rootMargin: "0px 0px -5% 0px" },
      );
      observer.observe(section);

      // Helper: paused fade-up timeline bound to its own trigger element, so
      // each group animates when ITS trigger enters view — never all at once.
      const bindStagedReveal = (
        targets: (HTMLElement | undefined)[],
        trigger: Element,
        bottomMargin: string,
      ) => {
        const els = targets.filter((el): el is HTMLElement => el != null);
        if (els.length === 0 || !trigger) return;
        const staged = gsap.timeline({
          paused: true,
          defaults: { ease: "power2.out", overwrite: "auto" },
        });
        // Short + snappy so the whole staged sequence finishes with less scroll.
        staged.to(els, { y: 0, autoAlpha: 1, duration: 0.32, stagger: 0 }, 0);
        const stagedObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.intersectionRatio >= 0.15) {
                staged.timeScale(1).play();
              } else if (entry.intersectionRatio === 0) {
                staged.pause(0);
              } else {
                staged.timeScale(2.5).reverse();
              }
            });
          },
          // Lower threshold fires a touch earlier on scroll-in.
          { threshold: [0, 0.15], rootMargin: `0px 0px ${bottomMargin} 0px` },
        );
        stagedObserver.observe(trigger);
      };

      // Contents 0 + 1 share the row wrapper as trigger so both fire
      // simultaneously on desktop AND mobile (where they stack vertically).
      const rowA = items[0]?.parentElement ?? items[0];
      // Step 1: h3s of 0+1 enter first (shallow trigger — fires earlier).
      bindStagedReveal([itemHeads[0], itemHeads[1]], rowA, "0%");
      // Step 2: ps of 0+1 enter together after a short scroll (tighter gap).
      bindStagedReveal([itemParas[0], itemParas[1]], rowA, "-12%");
      // Step 3: content 2 h3 once IT enters the viewport...
      if (items[2]) {
        bindStagedReveal([itemHeads[2]], items[2], "0%");
        // Step 4: ...then its p after a short scroll.
        bindStagedReveal([itemParas[2]], items[2], "-12%");
      }
    }, section);

    // Cleanup for Astro view transitions / HMR so timelines don't duplicate.
    document.addEventListener("astro:before-preparation", () => ctx.revert(), {
      once: true,
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPerfectReveal);
  } else {
    initPerfectReveal();
  }
  document.addEventListener("astro:page-load", initPerfectReveal);
</script>
