---
import Button from "../../components/Button.astro";
type Translations = typeof import("../../i18n/en").default;
type HeroContent = Translations["main"]["hero"];
interface Props {
  content: HeroContent;
}
const { content } = Astro.props as Props;

// Comprueba si la URL coincide con la raíz o los prefijos de idioma (/ , /es, /es/, /en, /en/)
const pathname = Astro.url.pathname;
---

<section
  class="w-full h-[calc(100svh-var(--header-height))] md:h-[60vh] lg:h-[calc(100vh-var(--header-height))] flex flex-col justify-center items-end overflow-hidden relative"
>
  <div
    class="w-full h-full relative flex flex-col justify-end items-center overflow-hidden"
  >
    <video
      class="w-full h-full object-cover object-center absolute inset-0 z-0"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      disablepictureinpicture
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/images/video-portada.mp4" type="video/mp4" />
    </video>
    <div
      class="w-full h-full absolute z-2 bg-gradient-to-t from-[#0D0D0D] to-transparent to-[105.19%]"
    >
    </div>
    <div
      class="container-full h-full flex flex-col justify-end items-center gap-4 md:gap-8 relative z-5 pb-10 md:pb-18"
    >
      <p class="tag-size text-white text-center">
        {content.tag}
      </p>
      <h1
        class="text-[56px] md:text-[72px] lg:text-[96px] font-rust text-white leading-[100%] font-normal fade-up-a text-center"
        set:html={content.title}
      />
      <div class="flex flex-col md:flex-row justify-center items-center gap-4  fade-up-a w-full md:w-auto">
        <Button
          text={content.buttons[0].label}
          href={content.buttons[0].href}
          textClass="uppercase"
          extraBtnClass="bg-secondary border-secondary"
          width="w-full md:w-[164px]"
        />
        <Button
          text={content?.buttons[1].label}
          href={content?.buttons[1].href}
          textClass=" text-paragraph md:text-white  uppercase"
          extraBtnClass="bg-white md:bg-transparent border-white"
          width="w-full md:w-[164px]"
        />
      </div>
    </div>
  </div>
</section>
