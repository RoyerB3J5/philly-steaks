---
type Translations = typeof import("../../i18n/en").default;
type BigContent = Translations["main"]["big"];
interface Props {
  content: BigContent;
}
const { content } = Astro.props as Props;
---

<section
  class="w-full h-screen md:h-[65vh] xl:h-screen relative flex justify-start items-start py-20"
>
  <img
    src="/images/main/big-back.webp"
    alt="Back Big Philly Steak"
    width="2500"
    height="1121"
    class="w-full h-full absolute inset-0 object-cover"
  />
  <div
    class="flex flex-col justify-center items-start gap-8 px-6 md:px-14 relative z-5 -rotate-4"
  >
    <p
      class="tag-size text-white text-start md:text-center"
      set:html={content.tag}
    />
    <h2
      class="text-[56px] md:text-[90px] lg:text-[120px] font-rust text-white leading-[100%] font-normal fade-up-a text-start"
      set:html={content.title}
    />
  </div>
  <img
    src="/images/main/big-plate.webp"
    class="absolute bottom-10 right-0 w-[90%] md:w-[45%] lg:w-[30%] h-auto"
    width="944"
    height="720"
    decoding="async"
    loading="lazy"
    alt="Big Philly Steak Plate"
  />
</section>
