---
import Button from "../../components/Button.astro";
import ReviewCarousel from "../../components/ReviewCarousel";

type Translations = typeof import("../../i18n/en").default;
type ReviewsContent = Translations["main"]["reviews"];
interface Props {
  content: ReviewsContent;
}
const { content } = Astro.props as Props;
---

<section
  class="w-full flex flex-col justify-center items-center relative bg-white"
>
  <div
    class="container-full flex flex-col lg:flex-row justify-center lg:justify-between items-center w-full py-20 xl:py-30 gap-7.5 lg:gap-4 xl:gap-15 overflow-hidden"
  >
    <div
      class="flex flex-col justify-center items-center lg:items-start gap-4 md:gap-6"
    >
      <p class="tag-size text-paragraph">{content.tag}</p>
      <h2
        class="text-[56px] md:text-[64px] xl:text-[80px] font-rust text-paragraph leading-[100%] font-normal fade-up-a text-start"
        set:html={content.title}
      />
    </div>
    <img
      src="/images/main/plate-review.webp"
      alt="Review"
      class="w-full md:w-[50%] lg:w-[30%] h-auto"
      width="922"
      height="551"
    />
    <ReviewCarousel items={content.opinion} client:load />
  </div>
</section>
