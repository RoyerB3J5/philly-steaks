---
type Translations = typeof import("../../i18n/en").default;
type SteaksContent = Translations["main"]["steaks"];
interface Props {
  content: SteaksContent;
}
const { content } = Astro.props as Props;
---

<section
  class="h-auto md:h-auto lg:h-[70vh] xl:h-screen w-full flex justify-center items-center bg-black"
>
  <div
    class="container-full flex flex-col justify-center items-center gap-6 md:gap-8 lg:gap-16 py-[50px] md:py-10 lg:py-0"
  >
    <div class="flex flex-col justify-center items-center gap-6 md:gap-7">
      <p class="tag-size text-white text-center">
        {content.tag}
      </p>
      <h2
        class="text-[56px] md:text-[96px] font-rust text-white leading-[100%] font-normal fade-up-a text-center"
        set:html={content.title}
      />
    </div>
    <ul
      class="w-full flex flex-col lg:flex-row justify-center items-center gap-8 lg:gap-4"
    >
      {
        content.plates.map((plate, index) => {
          // Si el index es par (0, 2, 4...) rota -2deg, si es impar (1, 3, 5...) rota 2deg
          const mobileRotate =
            index % 2 === 0 ? "-rotate-[2deg]" : "rotate-[2deg]";

          return (
            <li
              class={`w-full max-w-none md:max-w-[376px] h-auto flex justify-center items-center aspect-376/245 relative 
          lg:first:-rotate-[4deg] lg:last:rotate-[4deg] lg:first:translate-y-3 lg:last:translate-y-3 
          ${mobileRotate}`}
              style={`animation-delay: ${index * 0.2}s`}
            >
              <img
                src="/icons/back-food.svg"
                alt="Background"
                class="absolute inset-0 object-cover w-full h-full z-0"
                width="376"
                height="245"
                decoding="async"
                loading="lazy"
              />
              <div class="flex flex-col justify-center items-center gap-6 relative z-3">
                <img
                  src={`/icons/${plate.image}.svg`}
                  alt={plate.title}
                  width="700"
                  height="700"
                  decoding="async"
                  loading="lazy"
                  class="w-16 h-16 object-cover"
                />
                <div class="flex flex-col justify-center items-center gap-2 text-white">
                  <h3 class="font-rust text-[20px] md:text-[24px] leading-[120%] font-normal uppercase fade-up-a">
                    {plate.title}
                  </h3>
                  <p
                    class="paragraph text-center fade-up-a"
                    set:html={plate.despcription}
                  />
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
