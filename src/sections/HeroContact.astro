---
import Button from "../components/Button.astro";
type Translations = typeof import("../i18n/en").default;
type HeroContent = Translations["contact"]["form"];
interface Props {
  content: HeroContent;
}
const { content } = Astro.props as Props;

// Same line-split pattern as the Signature h2 so the mask reveal matches
const lines = content.title.split(/<br\s*\/?>/i);
---

<section
  class="w-full h-auto flex flex-col justify-start xl:justify-end items-center overflow-hidden relative bg-black"
>
  <div
    class="container-full flex flex-col md:flex-row justify-center md:justify-between items-center py-15 md:py-10 relative gap-6 md:gap-4 lg:gap-0 h-full"
  >
    <div
      class="flex flex-col justify-center items-center md:items-start w-full md:w-[40%] xl:w-[50%] relative"
    >
      <p class="tag-size text-white fade-up-a">{content.tag}</p>
      <h1
        class="text-[56px] md:text-[64px] lg:text-[80px] font-rust text-white leading-[100%] font-normal mask-reveal text-center md:text-start mt-4 md:mt-6 isolate"
      >
        {
          lines.map((line, index) => (
            <div
              class={`relative overflow-clip ${index !== 0 ? "z-[3] -mt-[0.4em] pt-[0.4em]" : "z-0"}`}
            >
              <span
                class="block font-rust mask-line"
                style={`animation-delay: ${index * 100}ms`}
                set:html={line}
              />
            </div>
          ))
        }
      </h1>
      <p class="paragraph fade-up-a text-white w-full xl:w-[70%] text-center md:text-start">
        {content.description}
      </p>
    </div>
    <div
      class="w-full md:w-[55%] xl:w-[50%] p-11 rounded-3xl bg-white/5 h-[50vh] xl:h-[65vh] fade-up-a"
    >
    </div>
  </div>
</section>
