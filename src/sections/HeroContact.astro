---
import Button from "../components/Button.astro";
type Translations = typeof import("../i18n/en").default;
type HeroContent = Translations["contact"]["form"];
interface Props {
  content: HeroContent;
}
const { content } = Astro.props as Props;
---

<section
  class="w-full h-[calc(100vh-var(--header-height))] flex flex-col justify-end items-center overflow-hidden relative bg-accent"
>
  <div class="container-full flex justify-between items-start pb-13 relative">
    <div
      class="flex flex-col justify-start items-start gap-8 w-[48%] max-w-[535px] relative h-full"
    >
      <img
        src="/images/tomate.webp"
        alt=""
        "Tomate"
        width="700"
        height="709"
        class="w-[156px] h-auto absolute bottom-[20%] left-[10%] rotate-[90deg]"
      />
      <img
        src="/images/papa.webp"
        alt="Papa"
        width="700"
        height="837"
        class="w-[140px] h-auto absolute -bottom-[10%] right-[0%] rotate-[20deg]"
      />
      <div class="flex flex-col justify-center items-start gap-4">
        <p class="uppercase subtitle-sm">{content.tag}</p>
        <h1 class="title uppercase">{content.title}</h1>
      </div>
      <p class="paragraph">{content.description}</p>
    </div>
    <div
      class="w-[52%] p-8 border-[1.5px] rounded-2xl border-black bg-white h-[65vh]"
    >
    </div>
  </div>
</section>
